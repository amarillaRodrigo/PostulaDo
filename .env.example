# Copy this file to .env and fill with your local database credentials.
# Do NOT commit your real .env file to the repository.

# Example PostgreSQL connection (replace user, password, host, port, dbname):
DATABASE_URL="postgresql://user:password@localhost:5432/postulado_db?schema=public"

# Optionally a DIRECT_URL can be used by Prisma in some deployments
# (la usa `prisma migrate deploy` cuando el proveedor exige una conexion directa).
# DIRECT_URL="postgresql://user:password@host:port/postulado_db?schema=public"

# Auth
JWT_SECRET="cambiar-en-produccion"
# Vida del access token. Corta a proposito: el cliente lo renueva con el
# refresh token (30 dias, rota en cada uso) sin que la persona vea la sesion caer.
JWT_EXPIRES_IN="15m"
PORT=3000

# Correo transaccional (confirmacion de la cuenta).
# Sin RESEND_API_KEY la API funciona igual: no manda el mail, lo registra en
# el log y la landing avisa que no pudo enviarlo.
# APP_PUBLIC_URL arma el enlace de verificacion; sin barra final.
APP_PUBLIC_URL="http://localhost:3001"
MAIL_FROM="PostulaDo <no-reply@rodrigoamarilla.tech>"
# RESEND_API_KEY="re_..."

# CORS: los origenes del navegador que pueden llamar a la API, separados por coma.
CORS_ORIGINS="http://localhost:3001,http://127.0.0.1:3001"

# Redis: por URL (proveedor gestionado, admite rediss://) o por host/puerto.
# REDIS_URL="rediss://default:password@host:6379"
REDIS_HOST="localhost"
REDIS_PORT=6379

# Modelo opcional. Sin SGLang la API igual funciona: extrae las tecnologias
# del texto de la oferta con el vocabulario local de 36 tecnologias.
SGLANG_URL="http://localhost:30000/v1"
SGLANG_API_KEY="EMPTY"
